---
import Icon from './Icon.astro';
import Frame from './Frame.astro';
import { heroShot } from '../data/products';
import '../styles/hero.css';
---
<section class="hero">
  <div class="wrap hero-in">
    <div class="hero-copy">
      <h1>Software you'll actually open.</h1>
      <p class="lede"><strong>Academy</strong> teaches web development, <strong>Sleuthbox</strong> teaches SQL, and <strong>Number Duel</strong> is a two-player game.</p>
      <div class="hero-cta">
        <a class="btn btn-green" href="#products">
          See our products
          <Icon name="arrow" size={14} strokeWidth={2.5} />
        </a>
      </div>
    </div>
    <div class="hero-shot">
      <div class="tilt" id="tilt">
        <Frame {...heroShot} lazy={false} />
      </div>
    </div>
  </div>
</section>
